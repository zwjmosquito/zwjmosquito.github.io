---
interface Link { link: string; label: string; }
interface Props { links: Link[] }
const { links } = Astro.props;
const path = Astro.url.pathname;
---
<nav class="hidden lg:block w-full py-6 border-b border-base-300 bg-base-100/70 backdrop-blur sticky top-0 z-40">
  <div class="max-w-4xl mx-auto flex justify-center gap-8 text-sm">
    {links.map((l) => {
      const active = path === l.link || (l.link !== "/" && path.startsWith(l.link));
      return (
        <a
          href={l.link}
          class={`${active ? "text-primary font-medium" : "text-base-content/70 hover:text-primary"} transition-colors`}
        >
          {l.label}
        </a>
      );
    })}
  </div>
</nav>
