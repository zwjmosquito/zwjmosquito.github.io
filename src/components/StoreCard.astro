---
interface Props {
  name: string;
  url: string;
  image?: string;
  description: string;
}
const { name, url, image, description } = Astro.props;
---
<a
  href={url}
  target="_blank"
  rel="noopener"
  class="block rounded-box bg-base-200 overflow-hidden hover:bg-base-300 transition-colors"
>
  {image && (
    <img
      src={image}
      alt={name}
      class="w-full h-48 object-cover bg-base-300"
      onerror="this.style.display='none'"
    />
  )}
  <div class="p-5">
    <h3 class="text-xl font-medium mb-1">{name}</h3>
    <p class="text-sm text-base-content/80">{description}</p>
    <p class="mt-3 text-sm text-primary">Visit →</p>
  </div>
</a>
