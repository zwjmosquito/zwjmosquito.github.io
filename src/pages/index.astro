---
import Layout from "../layouts/Layout.astro";
import JournalCard from "../components/JournalCard.astro";
import CyclingTeaser from "../components/CyclingTeaser.astro";
import { getCollection, getEntry } from "astro:content";

// Load hero singleton for avatar + name + tagline
const heroEntry = await getEntry("hero", "index");
const hero = heroEntry?.data ?? { name: "Wenji Zhang", description: "Notes, rides, and whatever else." };

// Load journal posts (skip drafts), sort newest first
const posts = (await getCollection("journal", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title={hero.name} description={hero.description}>
  <main class="max-w-3xl mx-auto px-4 py-10">
    <section class="flex items-center gap-4 mb-10">
      {hero.avatar && (
        <img
          src={typeof hero.avatar === "string" ? hero.avatar : hero.avatar.src}
          alt={hero.name}
          class="w-14 h-14 rounded-full object-cover"
        />
      )}
      <div>
        <h1 class="text-3xl font-medium leading-tight">{hero.name}</h1>
        <p class="text-neutral">{hero.description}</p>
      </div>
    </section>

    <CyclingTeaser />

    <div class="mt-10">
      {posts.length === 0 ? (
        <p class="text-neutral">Nothing posted yet.</p>
      ) : (
        posts.map(post => (
          <JournalCard
            title={post.data.title}
            date={post.data.date}
            excerpt={post.data.excerpt}
            slug={post.id}
          />
        ))
      )}
    </div>
  </main>
</Layout>
