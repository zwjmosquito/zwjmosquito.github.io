---
import Layout from "../../layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ProjectsLayoutGrid from "../../components/ProjectsLayoutGrid.astro";
import ProjectsLayoutTabsHorizontal from "../../components/ProjectsLayoutTabsHorizontal.astro";
import ProjectsLayoutTabsVertical from "../../components/ProjectsLayoutTabsVertical.astro";

const projects = await getCollection("projects");

// Load General settings for layout preference
const generalEntry = await getEntry("general", "index");
const projectsLayout = generalEntry?.data?.projectsLayout ?? "grid";

// No categories — all projects are uncategorized
interface CategoryGroup {
  slug: string;
  title: string;
  description?: string;
  icon?: string;
  projects: CollectionEntry<"projects">[];
}

const categoryGroups: CategoryGroup[] = [];

const uncategorizedProjects = projects.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);
---

<Layout
  title="Projects - Bloomfolio"
  description="Explore my latest projects and work"
>
  <main class="max-w-6xl mx-auto px-4 py-20">
    <!-- Header -->
    <div class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-4">Projects</h1>
      <p class="text-xl text-base-content/70">
        A collection of projects I've worked on, showcasing my skills and
        experience.
      </p>
    </div>

    <!-- Back to Home -->
    <div class="mb-8">
      <a href="/" class="btn btn-ghost btn-sm">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        Back to Home
      </a>
    </div>

    {
      projects.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-2xl text-base-content/60">
            No projects yet. Check back soon!
          </p>
        </div>
      ) : projectsLayout === "tabs-horizontal" ? (
        <ProjectsLayoutTabsHorizontal
          categoryGroups={categoryGroups}
          uncategorizedProjects={uncategorizedProjects}
        />
      ) : projectsLayout === "tabs-vertical" ? (
        <ProjectsLayoutTabsVertical
          categoryGroups={categoryGroups}
          uncategorizedProjects={uncategorizedProjects}
        />
      ) : (
        <ProjectsLayoutGrid
          categoryGroups={categoryGroups}
          uncategorizedProjects={uncategorizedProjects}
        />
      )
    }
  </main>
</Layout>
